[{"data":1,"prerenderedAt":221},["ShallowReactive",2],{"article:life\u002Fwho-i":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"lang":10,"date":11,"categories":12,"tags":14,"body":16,"_type":215,"_id":216,"_source":217,"_file":218,"_stem":219,"_extension":220},"\u002Flife\u002Fwho-i","blog",false,"","中子星是谁？","认识 Nash Aiomos（中子星）：一位喜欢编程、区块链、烹饪与探索的创作者，聊聊自己的兴趣、习惯和日常生活。","zh-Hans","2023-02-03",[13],"About me",[15],"Chinese & 中文",{"type":17,"children":18,"toc":212},"root",[19,31,35,45,48,56,61,66,71,74,82,87,92,95,105,108,116,121,126,129,137,142,145,153,158,161,169,174,177,185,190,193,201,206,209],{"type":20,"tag":21,"props":22,"children":23},"element","p",{},[24],{"type":20,"tag":25,"props":26,"children":27},"strong",{},[28],{"type":29,"value":30},"text","谁是中子星？",{"type":20,"tag":32,"props":33,"children":34},"br",{},[],{"type":20,"tag":21,"props":36,"children":37},{},[38,43],{"type":20,"tag":25,"props":39,"children":40},{},[41],{"type":29,"value":42},"啊，你问我是谁？我我，咳咳，我嘛，我是",{"type":29,"value":44},"第三代互联网应用创业者、NeutronStarDAO 和 IceCube 创始人、下一代网络基础设施项目投资人、区块链技术狂热爱好者、去中心化金融系统流动性提供者、加密货币忠实信徒、非同质化代币早期收藏家、数字黄金二级市场研究员（笑😉）",{"type":20,"tag":32,"props":46,"children":47},{},[],{"type":20,"tag":21,"props":49,"children":50},{},[51],{"type":20,"tag":25,"props":52,"children":53},{},[54],{"type":29,"value":55},"中子星喜欢简洁高效快速。",{"type":20,"tag":21,"props":57,"children":58},{},[59],{"type":29,"value":60},"大多数时候不喜欢聊天，包括手机上、面对面、路上。如果你要找他聊天，最好提前找个话题问他。",{"type":20,"tag":21,"props":62,"children":63},{},[64],{"type":29,"value":65},"但如果聊到感兴趣的东西：眼睛立马炸出星星，他会把你按在椅子上，直到听完他滔滔不绝的 “ 演讲 ” 。",{"type":20,"tag":21,"props":67,"children":68},{},[69],{"type":29,"value":70},"看视频一般 1.25 倍速，语速太慢就 1.5 、2.0 倍，电影除外。",{"type":20,"tag":32,"props":72,"children":73},{},[],{"type":20,"tag":21,"props":75,"children":76},{},[77],{"type":20,"tag":25,"props":78,"children":79},{},[80],{"type":29,"value":81},"中子星喜欢烹饪，但不经常做饭。",{"type":20,"tag":21,"props":83,"children":84},{},[85],{"type":29,"value":86},"喜欢虾、蟹、鱿鱼、烤肉、龙虾、甜点。讨厌饺子、鲤鱼（刺太多）、洋葱。",{"type":20,"tag":21,"props":88,"children":89},{},[90],{"type":29,"value":91},"从网上收集一堆某种菜的菜谱，先按菜谱小剂量实验，然后改进。尝一遍，排除不好吃的。把味道一般的和味道不错的记下来。调整配料配比、火候、时间等变量多次小剂量重复。控制变量，调制出最佳口感、最佳味道后，记下来配方：包括选什么食材、调料配比、腌制时间、调整火候的时间。但是正常情况下在房间里，上午一眨眼就过去了，没时间做饭，只能潦草弄一弄。",{"type":20,"tag":32,"props":93,"children":94},{},[],{"type":20,"tag":21,"props":96,"children":97},{},[98,103],{"type":20,"tag":25,"props":99,"children":100},{},[101],{"type":29,"value":102},"中子星不喜欢 GTA6 之外的任何游戏。",{"type":29,"value":104},"（截止 2024）",{"type":20,"tag":32,"props":106,"children":107},{},[],{"type":20,"tag":21,"props":109,"children":110},{},[111],{"type":20,"tag":25,"props":112,"children":113},{},[114],{"type":29,"value":115},"中子星几乎不收拾房间。",{"type":20,"tag":21,"props":117,"children":118},{},[119],{"type":29,"value":120},"经常用的东西都在附近，用完也随手放附近。不经常用的东西太占用桌子上有限的空间，桌子太满时，得扔进柜子里。这样能节约很多时间。",{"type":20,"tag":21,"props":122,"children":123},{},[124],{"type":29,"value":125},"最近经常用的东西不应该存进硬盘，这些东西应该呆在缓存里，这样读写速度最快。缓存快满时才需要清理一下空间，把不经常用的东西扔到硬盘里。家长总喜欢进房间把缓存全部清理掉，然而再找东西时特费时间，这要花很长时间才能 “ 还原 ” 。家长整理过的东西往往都消失不见了。",{"type":20,"tag":32,"props":127,"children":128},{},[],{"type":20,"tag":21,"props":130,"children":131},{},[132],{"type":20,"tag":25,"props":133,"children":134},{},[135],{"type":29,"value":136},"中子星从不叠被子。",{"type":20,"tag":21,"props":138,"children":139},{},[140],{"type":29,"value":141},"叠被子是不可能的，这辈子不可能叠被子的。最多把被子铺平在床上。",{"type":20,"tag":32,"props":143,"children":144},{},[],{"type":20,"tag":21,"props":146,"children":147},{},[148],{"type":20,"tag":25,"props":149,"children":150},{},[151],{"type":29,"value":152},"中子星讨厌逛街。",{"type":20,"tag":21,"props":154,"children":155},{},[156],{"type":29,"value":157},"不如打开手机，搜索需要的衣服，支付完成。因为街上很难买到 190 cm 的衣服和 46 码的鞋，而且很浪费时间，在网上收藏几家专门卖高个子衣服的店铺就解决了。",{"type":20,"tag":32,"props":159,"children":160},{},[],{"type":20,"tag":21,"props":162,"children":163},{},[164],{"type":20,"tag":25,"props":165,"children":166},{},[167],{"type":29,"value":168},"中子星喜欢看书、写博客、做笔记、写总结、归纳知识库、科幻小说、有声书、优质电影、密码学、动画特效、加密货币交易。",{"type":20,"tag":21,"props":170,"children":171},{},[172],{"type":29,"value":173},"内向的人不喜欢社交。",{"type":20,"tag":32,"props":175,"children":176},{},[],{"type":20,"tag":21,"props":178,"children":179},{},[180],{"type":20,"tag":25,"props":181,"children":182},{},[183],{"type":29,"value":184},"中子星爱区块链、隐私计算、人工智能、操作系统这类计算机技术。",{"type":20,"tag":21,"props":186,"children":187},{},[188],{"type":29,"value":189},"正在学习。",{"type":20,"tag":32,"props":191,"children":192},{},[],{"type":20,"tag":21,"props":194,"children":195},{},[196],{"type":20,"tag":25,"props":197,"children":198},{},[199],{"type":29,"value":200},"中子星喜欢羽毛球、远足、慢跑。",{"type":20,"tag":21,"props":202,"children":203},{},[204],{"type":29,"value":205},"自认为羽毛球打得不错。有时候想出去走走，找个公园绿地湖边绿道，塞上耳机，欣赏风景， 15 公里左右。",{"type":20,"tag":32,"props":207,"children":208},{},[],{"type":20,"tag":32,"props":210,"children":211},{},[],{"title":7,"searchDepth":213,"depth":213,"links":214},2,[],"markdown","content:blog:who-i.md","content","blog\u002Fwho-i.md","blog\u002Fwho-i","md",1794571147945]