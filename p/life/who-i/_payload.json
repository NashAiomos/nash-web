[{"data":1,"prerenderedAt":220},["ShallowReactive",2],{"content-query-CrCRJ6jrnc":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"lang":10,"date":11,"categories":12,"tags":14,"body":16,"_type":214,"_id":215,"_source":216,"_file":217,"_stem":218,"_extension":219},"\u002Flife\u002Fwho-i","blog",false,"","中子星是谁？","谁是中子星？","zh-Hans","2023-02-03",[13],"About me",[15],"Chinese & 中文",{"type":17,"children":18,"toc":211},"root",[19,30,34,44,47,55,60,65,70,73,81,86,91,94,104,107,115,120,125,128,136,141,144,152,157,160,168,173,176,184,189,192,200,205,208],{"type":20,"tag":21,"props":22,"children":23},"element","p",{},[24],{"type":20,"tag":25,"props":26,"children":27},"strong",{},[28],{"type":29,"value":9},"text",{"type":20,"tag":31,"props":32,"children":33},"br",{},[],{"type":20,"tag":21,"props":35,"children":36},{},[37,42],{"type":20,"tag":25,"props":38,"children":39},{},[40],{"type":29,"value":41},"啊，你问我是谁？我我，咳咳，我嘛，我是",{"type":29,"value":43},"第三代互联网应用创业者、NeutronStarDAO 和 IceCube 创始人、下一代网络基础设施项目投资人、区块链技术狂热爱好者、去中心化金融系统流动性提供者、加密货币忠实信徒、非同质化代币早期收藏家、数字黄金二级市场研究员（笑😉）",{"type":20,"tag":31,"props":45,"children":46},{},[],{"type":20,"tag":21,"props":48,"children":49},{},[50],{"type":20,"tag":25,"props":51,"children":52},{},[53],{"type":29,"value":54},"中子星喜欢简洁高效快速。",{"type":20,"tag":21,"props":56,"children":57},{},[58],{"type":29,"value":59},"大多数时候不喜欢聊天，包括手机上、面对面、路上。如果你要找他聊天，最好提前找个话题问他。",{"type":20,"tag":21,"props":61,"children":62},{},[63],{"type":29,"value":64},"但如果聊到感兴趣的东西：眼睛立马炸出星星，他会把你按在椅子上，直到听完他滔滔不绝的 “ 演讲 ” 。",{"type":20,"tag":21,"props":66,"children":67},{},[68],{"type":29,"value":69},"看视频一般 1.25 倍速，语速太慢就 1.5 、2.0 倍，电影除外。",{"type":20,"tag":31,"props":71,"children":72},{},[],{"type":20,"tag":21,"props":74,"children":75},{},[76],{"type":20,"tag":25,"props":77,"children":78},{},[79],{"type":29,"value":80},"中子星喜欢烹饪，但不经常做饭。",{"type":20,"tag":21,"props":82,"children":83},{},[84],{"type":29,"value":85},"喜欢虾、蟹、鱿鱼、烤肉、龙虾、甜点。讨厌饺子、鲤鱼（刺太多）、洋葱。",{"type":20,"tag":21,"props":87,"children":88},{},[89],{"type":29,"value":90},"从网上收集一堆某种菜的菜谱，先按菜谱小剂量实验，然后改进。尝一遍，排除不好吃的。把味道一般的和味道不错的记下来。调整配料配比、火候、时间等变量多次小剂量重复。控制变量，调制出最佳口感、最佳味道后，记下来配方：包括选什么食材、调料配比、腌制时间、调整火候的时间。但是正常情况下在房间里，上午一眨眼就过去了，没时间做饭，只能潦草弄一弄。",{"type":20,"tag":31,"props":92,"children":93},{},[],{"type":20,"tag":21,"props":95,"children":96},{},[97,102],{"type":20,"tag":25,"props":98,"children":99},{},[100],{"type":29,"value":101},"中子星不喜欢 GTA6 之外的任何游戏。",{"type":29,"value":103},"（截止 2024）",{"type":20,"tag":31,"props":105,"children":106},{},[],{"type":20,"tag":21,"props":108,"children":109},{},[110],{"type":20,"tag":25,"props":111,"children":112},{},[113],{"type":29,"value":114},"中子星几乎不收拾房间。",{"type":20,"tag":21,"props":116,"children":117},{},[118],{"type":29,"value":119},"经常用的东西都在附近，用完也随手放附近。不经常用的东西太占用桌子上有限的空间，桌子太满时，得扔进柜子里。这样能节约很多时间。",{"type":20,"tag":21,"props":121,"children":122},{},[123],{"type":29,"value":124},"最近经常用的东西不应该存进硬盘，这些东西应该呆在缓存里，这样读写速度最快。缓存快满时才需要清理一下空间，把不经常用的东西扔到硬盘里。家长总喜欢进房间把缓存全部清理掉，然而再找东西时特费时间，这要花很长时间才能 “ 还原 ” 。家长整理过的东西往往都消失不见了。",{"type":20,"tag":31,"props":126,"children":127},{},[],{"type":20,"tag":21,"props":129,"children":130},{},[131],{"type":20,"tag":25,"props":132,"children":133},{},[134],{"type":29,"value":135},"中子星从不叠被子。",{"type":20,"tag":21,"props":137,"children":138},{},[139],{"type":29,"value":140},"叠被子是不可能的，这辈子不可能叠被子的。最多把被子铺平在床上。",{"type":20,"tag":31,"props":142,"children":143},{},[],{"type":20,"tag":21,"props":145,"children":146},{},[147],{"type":20,"tag":25,"props":148,"children":149},{},[150],{"type":29,"value":151},"中子星讨厌逛街。",{"type":20,"tag":21,"props":153,"children":154},{},[155],{"type":29,"value":156},"不如打开手机，搜索需要的衣服，支付完成。因为街上很难买到 190 cm 的衣服和 46 码的鞋，而且很浪费时间，在网上收藏几家专门卖高个子衣服的店铺就解决了。",{"type":20,"tag":31,"props":158,"children":159},{},[],{"type":20,"tag":21,"props":161,"children":162},{},[163],{"type":20,"tag":25,"props":164,"children":165},{},[166],{"type":29,"value":167},"中子星喜欢看书、写博客、做笔记、写总结、归纳知识库、科幻小说、有声书、优质电影、密码学、动画特效、加密货币交易。",{"type":20,"tag":21,"props":169,"children":170},{},[171],{"type":29,"value":172},"内向的人不喜欢社交。",{"type":20,"tag":31,"props":174,"children":175},{},[],{"type":20,"tag":21,"props":177,"children":178},{},[179],{"type":20,"tag":25,"props":180,"children":181},{},[182],{"type":29,"value":183},"中子星爱区块链、隐私计算、人工智能、操作系统这类计算机技术。",{"type":20,"tag":21,"props":185,"children":186},{},[187],{"type":29,"value":188},"正在学习。",{"type":20,"tag":31,"props":190,"children":191},{},[],{"type":20,"tag":21,"props":193,"children":194},{},[195],{"type":20,"tag":25,"props":196,"children":197},{},[198],{"type":29,"value":199},"中子星喜欢羽毛球、远足、慢跑。",{"type":20,"tag":21,"props":201,"children":202},{},[203],{"type":29,"value":204},"自认为羽毛球打得不错。有时候想出去走走，找个公园绿地湖边绿道，塞上耳机，欣赏风景， 15 公里左右。",{"type":20,"tag":31,"props":206,"children":207},{},[],{"type":20,"tag":31,"props":209,"children":210},{},[],{"title":7,"searchDepth":212,"depth":212,"links":213},2,[],"markdown","content:blog:who-i.md","content","blog\u002Fwho-i.md","blog\u002Fwho-i","md",1793885408950]