[{"data":1,"prerenderedAt":299},["ShallowReactive",2],{"content-query-75Lg1P5ZWz":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"lang":10,"date":11,"categories":12,"tags":14,"body":17,"_type":293,"_id":294,"_source":295,"_file":296,"_stem":297,"_extension":298},"\u002Fblog\u002Ffuture","blog",false,"","后知后觉","想象一下，假设现在的机器人技术非常发达了。","zh-Hans","2021-12-27",[13],"Ponder on the world",[15,16],"Chinese & 中文","Future dreamer",{"type":18,"children":19,"toc":290},"root",[20,27,32,37,42,46,49,54,59,64,69,78,83,88,97,110,119,124,136,141,144,147,159,162,171,176,181,186,191,197,202,207,212,217,222,227,230,235,240,245,248,253,258,263,266,269,274,282,287],{"type":21,"tag":22,"props":23,"children":24},"element","p",{},[25],{"type":26,"value":9},"text",{"type":21,"tag":22,"props":28,"children":29},{},[30],{"type":26,"value":31},"那么机器人可以代替人力去做基础性劳动了：由机器人负责种地、浇水，机器人用饲料喂猪，机器人杀猪，机器人做饭、烹饪猪肉等等（实际上这些工作不需要机器人也可以实现完全自动化，但为了方便理解，所以统一说成机器人）。",{"type":21,"tag":22,"props":33,"children":34},{},[35],{"type":26,"value":36},"这时候就会有很多普通人将会因为没事干而把大多数时间花在短视频、电影、游戏上（虚拟世界）。",{"type":21,"tag":22,"props":38,"children":39},{},[40],{"type":26,"value":41},"实际上，人们更愿意把时间放在网络上、在游戏里、在虚拟空间里，而不是去乡下锄地或者喂猪。",{"type":21,"tag":43,"props":44,"children":45},"br",{},[],{"type":21,"tag":43,"props":47,"children":48},{},[],{"type":21,"tag":22,"props":50,"children":51},{},[52],{"type":26,"value":53},"如果除了睡觉，所有醒着的时间都花在虚拟世界里，真实世界与虚拟世界的界限将越来越模糊。（有 VR 、MR 等等技术）",{"type":21,"tag":22,"props":55,"children":56},{},[57],{"type":26,"value":58},"虚拟世界里有种资产叫 “ Token ” ，人们都喜欢虚拟世界里赚钱，赚到的钱大多数也花在了虚拟世界。",{"type":21,"tag":22,"props":60,"children":61},{},[62],{"type":26,"value":63},"人们愿意把钱存在虚拟世界的银行里。",{"type":21,"tag":22,"props":65,"children":66},{},[67],{"type":26,"value":68},"以区块链技术作为底层基建，这时候网络上的资产才真正叫自己的资产。",{"type":21,"tag":22,"props":70,"children":71},{},[72,75],{"type":21,"tag":43,"props":73,"children":74},{},[],{"type":21,"tag":43,"props":76,"children":77},{},[],{"type":21,"tag":22,"props":79,"children":80},{},[81],{"type":26,"value":82},"家家户户的卧室都改造成 “ VR 室 ”  ，有床有VR设备，有送餐机器人，有打包式马桶... （现在的电竞酒店）",{"type":21,"tag":22,"props":84,"children":85},{},[86],{"type":26,"value":87},"因为大众都沉溺虚拟世界，导致大多数人都有肥胖问题，所以家里的 VR 室还有跑步机，人们可以带着头盔跑步，这叫云跑步，你可以在地球上的 “ 任何地方 ” 跑步，甚至可以在水面上跑步。还有不同的鞋为你提供不同的脚底触感。",{"type":21,"tag":22,"props":89,"children":90},{},[91,94],{"type":21,"tag":43,"props":92,"children":93},{},[],{"type":21,"tag":43,"props":95,"children":96},{},[],{"type":21,"tag":22,"props":98,"children":99},{},[100,102,108],{"type":26,"value":101},"还有一部分中年人不喜欢虚拟世界：“ That's fucking ridiculous ! ”，",{"type":21,"tag":103,"props":104,"children":105},"strong",{},[106],{"type":26,"value":107},"荒谬绝伦",{"type":26,"value":109},"！“ 我要回归自然 ~ ” 。\n他们的口号是：远离虚拟世界，抵制虚拟世界。",{"type":21,"tag":22,"props":111,"children":112},{},[113,116],{"type":21,"tag":43,"props":114,"children":115},{},[],{"type":21,"tag":43,"props":117,"children":118},{},[],{"type":21,"tag":22,"props":120,"children":121},{},[122],{"type":26,"value":123},"我打开门，看见女儿忘记摘掉 VR 头显就睡着了，傻丫头！我悄悄帮她摘下 VR 头显，顺便看一下她在虚拟世界干嘛，嘿嘿。",{"type":21,"tag":22,"props":125,"children":126},{},[127,129,134],{"type":26,"value":128},"嚯！是在和同学家里开生日 party ，和现实一模一样，她同学刚刚搬到了新楼盘，在现实买一套房就送一套虚拟世界里的房。\n我惊叹于这",{"type":21,"tag":103,"props":130,"children":131},{},[132],{"type":26,"value":133},"精妙绝伦",{"type":26,"value":135},"的世界，天上飞的水里游的，骑上就能满世界跑，还有时间轴！你能回到恐龙时代、中世纪骑士、朋克战争，在身临其境演唱会里嗨翻全场。现实世界里的事情也会实时传入虚拟世界。",{"type":21,"tag":22,"props":137,"children":138},{},[139],{"type":26,"value":140},"现实里有的没的，这里都有，我也开始慢慢接受这个 “ 新世界 ” 了。",{"type":21,"tag":43,"props":142,"children":143},{},[],{"type":21,"tag":43,"props":145,"children":146},{},[],{"type":21,"tag":22,"props":148,"children":149},{},[150,152,157],{"type":26,"value":151},"技术发展的真快！我还记得我 20 岁时，人们只能打打联机游戏，刷刷无聊的短视频，",{"type":21,"tag":103,"props":153,"children":154},{},[155],{"type":26,"value":156},"在呆板的平面屏幕上与互联网交互",{"type":26,"value":158},"。",{"type":21,"tag":43,"props":160,"children":161},{},[],{"type":21,"tag":22,"props":163,"children":164},{},[165,168],{"type":21,"tag":43,"props":166,"children":167},{},[],{"type":21,"tag":43,"props":169,"children":170},{},[],{"type":21,"tag":22,"props":172,"children":173},{},[174],{"type":26,"value":175},"在这个虚拟世界里，每个人都是主角。（相当于每个人都自带直播设备，随时直播；当然也可以“关闭直播”，在虚拟空间里的隐私一样很重要）",{"type":21,"tag":22,"props":177,"children":178},{},[179],{"type":26,"value":180},"技术爆炸时代：在高三时看过 Tim Urban 的文章。他介绍过一个很有意思的概念：",{"type":21,"tag":22,"props":182,"children":183},{},[184],{"type":26,"value":185},"大多数人对未来技术的预测都是悲观的，因为科技发展是越来越快的指数型增长。",{"type":21,"tag":22,"props":187,"children":188},{},[189],{"type":26,"value":190},"目前已经看到的科技水平的发展：",{"type":21,"tag":192,"props":193,"children":196},"img",{"alt":194,"src":195},"科技水平随时间逐渐加速上升的曲线","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002Fc3c924b9bf93f1b08ec591f8d4f473de.png",[],{"type":21,"tag":22,"props":198,"children":199},{},[200],{"type":26,"value":201},"以现在的视角预测未来科技走向:",{"type":21,"tag":192,"props":203,"children":206},{"alt":204,"src":205},"以历史时间节点展示科技增长加速的示意图","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002Feed595f94d665b63dd2e446f6a3d8d3b.png",[],{"type":21,"tag":22,"props":208,"children":209},{},[210],{"type":26,"value":211},"实际上未来的趋势是这样的：",{"type":21,"tag":192,"props":213,"children":216},{"alt":214,"src":215},"科技增长曲线在后期陡峭上升","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F40826f2933f48fe08299652ab3452da3.png",[],{"type":21,"tag":22,"props":218,"children":219},{},[220],{"type":26,"value":221},"我们变得更好之后，我们就能更好地变得更好。而当我们能更好地变得更好之后，我们也就能更快地变得更好。",{"type":21,"tag":22,"props":223,"children":224},{},[225],{"type":26,"value":226},"世界在加速进入新时代，越来越快，资源将无比丰富，效率将持续提高。",{"type":21,"tag":43,"props":228,"children":229},{},[],{"type":21,"tag":22,"props":231,"children":232},{},[233],{"type":26,"value":234},"全世界都在等区块链，确切地说，是全世界都在等一种可以大规模部署应用的高速公链。",{"type":21,"tag":22,"props":236,"children":237},{},[238],{"type":26,"value":239},"个人认为以前的洛克王国、QQ 企鹅社区、现在的我的世界、英雄联盟、GTAonline 等等联机游戏，在线的、局域网的都差一个共识算法做底层。\n如果这些游戏在区块链上部署，每个游戏都是一个元宇宙。",{"type":21,"tag":22,"props":241,"children":242},{},[243],{"type":26,"value":244},"目前的 Web3 仍然停留在初始阶段，基础设施都还没有建成，玩法还在探索，但是进展很快。这个领域应该会诞生无数的创新和机会，值得密切关注。",{"type":21,"tag":43,"props":246,"children":247},{},[],{"type":21,"tag":22,"props":249,"children":250},{},[251],{"type":26,"value":252},"疫情期间，许多人都在家办公。以前，上班的目的地是办公室，现在变成了键盘和显示器。",{"type":21,"tag":22,"props":254,"children":255},{},[256],{"type":26,"value":257},"既然人们可以在计算机前面工作 8 小时。如果能够提供更好的虚拟办公条件，这 8 小时完全可以在虚拟空间里面度过。",{"type":21,"tag":22,"props":259,"children":260},{},[261],{"type":26,"value":262},"相比 “ 看电影 ” 人们更喜欢 “ 玩游戏 ”，因为电影是人家拍好给你看，而你可以参与进游戏里，人们都喜欢自己能参与进去的虚拟空间，人们需要互动、交互。",{"type":21,"tag":43,"props":264,"children":265},{},[],{"type":21,"tag":43,"props":267,"children":268},{},[],{"type":21,"tag":22,"props":270,"children":271},{},[272],{"type":26,"value":273},"元宇宙将在几年后卷土重来。",{"type":21,"tag":22,"props":275,"children":276},{},[277,279],{"type":26,"value":278},"包括每个国家、每个行业、每个人的未来都将被元宇宙深刻影响，元宇宙终会改写人类未来简史。\n",{"type":21,"tag":43,"props":280,"children":281},{},[],{"type":21,"tag":192,"props":283,"children":286},{"alt":284,"src":285},"技术从初期热潮、泡沫破裂到成熟发展的曲线","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002Fcd4d11d66c20829973e6d3620752aa6b.png",[],{"type":21,"tag":43,"props":288,"children":289},{},[],{"title":7,"searchDepth":291,"depth":291,"links":292},2,[],"markdown","content:blog:future.md","content","blog\u002Ffuture.md","blog\u002Ffuture","md",1793885409049]