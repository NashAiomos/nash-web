[{"data":1,"prerenderedAt":422},["ShallowReactive",2],{"content-query-FXCRD5WFJ5":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"lang":10,"date":11,"categories":12,"tags":14,"body":16,"_type":416,"_id":417,"_source":418,"_file":419,"_stem":420,"_extension":421},"\u002Fblog\u002Fabout-note","blog",false,"","关于记笔记","当你闭上眼睛，回想自己掌握的知识时，你会发现自己掌握的东西少得可怜：","zh-Hans","2022-10-17",[13],"Computer technology",[15],"Chinese & 中文",{"type":17,"children":18,"toc":410},"root",[19,26,33,38,43,53,58,63,68,77,82,87,96,102,107,112,117,122,128,131,136,141,150,155,160,165,174,179,184,193,198,203,212,217,222,227,232,237,242,247,252,257,266,271,291,300,316,321,326,331,337,340,345,351,356,361,366,371,380,401],{"type":20,"tag":21,"props":22,"children":23},"element","p",{},[24],{"type":25,"value":9},"text",{"type":20,"tag":27,"props":28,"children":32},"img",{"alt":29,"src":30,"style":31},"用同心圆表示不同范围知识之间的关系","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F36aeabe8e7563462ac2e2d2c70dbec54.png","zoom:50%;",[],{"type":20,"tag":21,"props":34,"children":35},{},[36],{"type":25,"value":37},"我总是怕脑子把学过的东西忘了，相信 “ 好记性不如烂笔头 ” ，把笔记写的很详细（写笔记是相当于要向一个刚入门的小白讲清楚所有知识，也就是做通俗易懂、面面俱到的笔记，以便很多年后我忘掉这些知识以后可以通过笔记快速复习回忆），结果深陷记笔记泥潭进度严重滞后。",{"type":20,"tag":21,"props":39,"children":40},{},[41],{"type":25,"value":42},"其实脑子根本没有那么容易忘记，因为每天都和那些东西打交道。",{"type":20,"tag":21,"props":44,"children":45},{},[46,50],{"type":20,"tag":47,"props":48,"children":49},"br",{},[],{"type":20,"tag":47,"props":51,"children":52},{},[],{"type":20,"tag":21,"props":54,"children":55},{},[56],{"type":25,"value":57},"现在想学编程，完全可以从网上获取成为一个合格计算机工程师所需的全部资料。",{"type":20,"tag":21,"props":59,"children":60},{},[61],{"type":25,"value":62},"然而面对 “ 堆积如山 ” 的资料，我意识到想把这么多资料整理到自己的 markdown 笔记里、总结完是不可能的，能认真看完就不错了。",{"type":20,"tag":21,"props":64,"children":65},{},[66],{"type":25,"value":67},"只能把它们归类，然后按原有的形态存着。",{"type":20,"tag":21,"props":69,"children":70},{},[71,74],{"type":20,"tag":47,"props":72,"children":73},{},[],{"type":20,"tag":47,"props":75,"children":76},{},[],{"type":20,"tag":21,"props":78,"children":79},{},[80],{"type":25,"value":81},"以做代学，实战上手边做边学（直接开始研究 \u002F 做中等难度的东西，再降维打击简单的内容，最后打牢基础攻关难的）；不必整合各种学习资料、做详细笔记，看视频和看书脑子理解了，看懂就行。笔记只记录精华思想、感悟即可。学完后有时间再快速归档整理一下笔记，顺便反思研究。",{"type":20,"tag":21,"props":83,"children":84},{},[85],{"type":25,"value":86},"以快速突进掌握实践技术为主，笔记后续跟进迅速完善覆盖。如果是从基础开始学一点做一点笔记、笔记做的特别详细，虽然笔记做的很好，但是可能会严重拖慢进度。",{"type":20,"tag":21,"props":88,"children":89},{},[90,93],{"type":20,"tag":47,"props":91,"children":92},{},[],{"type":20,"tag":47,"props":94,"children":95},{},[],{"type":20,"tag":97,"props":98,"children":100},"h2",{"id":99},"不要什么都记",[101],{"type":25,"value":99},{"type":20,"tag":21,"props":103,"children":104},{},[105],{"type":25,"value":106},"不要做基础文档笔记：直接复制现有文档就行了。",{"type":20,"tag":21,"props":108,"children":109},{},[110],{"type":25,"value":111},"基础知识网上都有，不用记，看已有的文档书籍即可，由 PDF 文件、复制下来的 markdown 文件、HTML 文件 组成。",{"type":20,"tag":21,"props":113,"children":114},{},[115],{"type":25,"value":116},"在学习过基础之后，记录一下 遇到的问题、解决方法、思路、总结 这些中高级笔记。",{"type":20,"tag":21,"props":118,"children":119},{},[120],{"type":25,"value":121},"技术永远在更新，你的精力有限，不可能把所有东西都做一遍笔记，然后一直维护这些笔记确保它们不过时。",{"type":20,"tag":27,"props":123,"children":127},{"alt":124,"src":125,"style":126},"从基础知识、总结到个人知识笔记的分层示意图","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F2048dc5f6e3172152d62a7e63530e2a5.png","zoom:30%;",[],{"type":20,"tag":47,"props":129,"children":130},{},[],{"type":20,"tag":97,"props":132,"children":134},{"id":133},"研究计算机基础",[135],{"type":25,"value":133},{"type":20,"tag":21,"props":137,"children":138},{},[139],{"type":25,"value":140},"学的基础知识底层知识越多越牢，先补一些计算机基础，学新知识也越快。",{"type":20,"tag":21,"props":142,"children":143},{},[144,147],{"type":20,"tag":47,"props":145,"children":146},{},[],{"type":20,"tag":47,"props":148,"children":149},{},[],{"type":20,"tag":21,"props":151,"children":152},{},[153],{"type":25,"value":154},"计算机知识体系像一棵树🌲，越底层的东西越难。",{"type":20,"tag":21,"props":156,"children":157},{},[158],{"type":25,"value":159},"你从树叶开始入门，如果你只会一根树枝的知识，那你只能轻松精通这一根树枝上所有树叶的知识。",{"type":20,"tag":21,"props":161,"children":162},{},[163],{"type":25,"value":164},"（树干 = 底层知识：计算机基础；树枝 = 中层知识：框架原理；树叶 = 简单的应用层知识：框架使用）",{"type":20,"tag":21,"props":166,"children":167},{},[168,171],{"type":20,"tag":47,"props":169,"children":170},{},[],{"type":20,"tag":47,"props":172,"children":173},{},[],{"type":20,"tag":21,"props":175,"children":176},{},[177],{"type":25,"value":178},"如果你学习了 2 种树枝的知识你就可以快速掌握这 2 个树枝上新长出来的树叶知识，但是要学习其他树枝那就得多花点精力学习了。",{"type":20,"tag":21,"props":180,"children":181},{},[182],{"type":25,"value":183},"如果你花时间研究明白了树干的知识，那对你来说，学习树枝和树叶就简单了，你可以快速学习几乎任何一个方向，比如前端、后端等等，因为你已经有树干了。",{"type":20,"tag":21,"props":185,"children":186},{},[187,190],{"type":20,"tag":47,"props":188,"children":189},{},[],{"type":20,"tag":47,"props":191,"children":192},{},[],{"type":20,"tag":21,"props":194,"children":195},{},[196],{"type":25,"value":197},"总之，你要成为高级工程师的树干就那么粗，早晚都得学，而且如果掌握了树干，上面长出新树叶就能快速学习了。",{"type":20,"tag":21,"props":199,"children":200},{},[201],{"type":25,"value":202},"另一种极端情况：如果只会树叶，不会树枝，就只能拼命跟随树叶，长出来多少树叶，就要学多少树叶。",{"type":20,"tag":21,"props":204,"children":205},{},[206,209],{"type":20,"tag":47,"props":207,"children":208},{},[],{"type":20,"tag":47,"props":210,"children":211},{},[],{"type":20,"tag":97,"props":213,"children":215},{"id":214},"技术发展与职业规划",[216],{"type":25,"value":214},{"type":20,"tag":21,"props":218,"children":219},{},[220],{"type":25,"value":221},"技术的发展是很快，新技术层出不穷，迭代非常快。",{"type":20,"tag":21,"props":223,"children":224},{},[225],{"type":25,"value":226},"阮一峰老师的博客里提出过这个问题。",{"type":20,"tag":21,"props":228,"children":229},{},[230],{"type":25,"value":231},"大致意思是说：",{"type":20,"tag":21,"props":233,"children":234},{},[235],{"type":25,"value":236},"学习技术的可能过不了 7、8 年就淘汰了。就像在 2007 年刚学习了诺基亚的塞班系统开发，苹果 、安卓又开始偷偷萌芽了。",{"type":20,"tag":21,"props":238,"children":239},{},[240],{"type":25,"value":241},"2020 年的时候在武汉大学校园里见过一次无人车，“ 别人家的学校🥹 ” ，当时有很多同学拍照，感觉这黑科技太酷了。但是无人车差不多也只是在 2016、2017 年左右开始火的。",{"type":20,"tag":21,"props":243,"children":244},{},[245],{"type":25,"value":246},"刚毕业时学的技术栈不太可能用到退休（50 年），只能在毕业后的 5 ~ 15 年用上，之后就得靠底层的树干技术学习新树叶了。",{"type":20,"tag":21,"props":248,"children":249},{},[250],{"type":25,"value":251},"（50 年，22 岁到 75 岁左右，这里有为什么 75 岁退休：医疗条件好 > 不愿意生孩子 > 人口老龄化 > 财政税收不能负担退休金 > 延迟退休，所以为什么医疗条件这么好 > 因为科技在爆炸式发展，00 后的人活 120 岁左右）",{"type":20,"tag":21,"props":253,"children":254},{},[255],{"type":25,"value":256},"当一种技术被取代时，相关的工作岗位也就消失了。这种事情在技术行业特别多，因为技术的升级换代太快了。",{"type":20,"tag":21,"props":258,"children":259},{},[260,263],{"type":20,"tag":47,"props":261,"children":262},{},[],{"type":20,"tag":47,"props":264,"children":265},{},[],{"type":20,"tag":21,"props":267,"children":268},{},[269],{"type":25,"value":270},"怎么应对技术太快：",{"type":20,"tag":272,"props":273,"children":274},"ol",{},[275,281,286],{"type":20,"tag":276,"props":277,"children":278},"li",{},[279],{"type":25,"value":280},"退出技术行业，转行",{"type":20,"tag":276,"props":282,"children":283},{},[284],{"type":25,"value":285},"转管理，或者创业开公司",{"type":20,"tag":276,"props":287,"children":288},{},[289],{"type":25,"value":290},"拼命学习，靠基础好、深入底层，学习速度会比年轻人快",{"type":20,"tag":21,"props":292,"children":293},{},[294,297],{"type":20,"tag":47,"props":295,"children":296},{},[],{"type":20,"tag":47,"props":298,"children":299},{},[],{"type":20,"tag":21,"props":301,"children":302},{},[303,305,314],{"type":25,"value":304},"在现在，从",{"type":20,"tag":306,"props":307,"children":311},"a",{"href":308,"rel":309},"https:\u002F\u002Fwww.ruanyifeng.com\u002Fsurvivor\u002Fcollapse\u002Funiversity.html",[310],"nofollow",[312],{"type":25,"value":313},"网上",{"type":25,"value":315},"几乎可以获取所有学习资料。",{"type":20,"tag":21,"props":317,"children":318},{},[319],{"type":25,"value":320},"我很讨厌上课，在上课时我很难学到真正有用的知识，也可能是学校教的内容太传统 😴。于是乎，我上课前都会偷偷卸载教室电脑的投屏授课软件，然后学习我想学的东西，这种感觉很好，感觉时间没有浪费。这样我就能利用上课时间去学习需要的东西。",{"type":20,"tag":21,"props":322,"children":323},{},[324],{"type":25,"value":325},"我不依赖上课，只从图书馆借书或者从网上收集资料（电子书、别人的技术文章、网课）。网课的效率非常高，我可以把视频调到 1.5 倍速，或者跳过我已经知道的地方，直接快进到我想听的地方。当然不是所有人都适合我这种方法，只是我自己喜欢这样学罢了。",{"type":20,"tag":21,"props":327,"children":328},{},[329],{"type":25,"value":330},"每个人都有适合自己的学习方法。",{"type":20,"tag":27,"props":332,"children":336},{"alt":333,"src":334,"style":335},"包含曲线、饼图和知识结构的笔记页面","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002Ff568df9647bb1aa1a5d034aeeb836306.png","zoom:150%;",[],{"type":20,"tag":47,"props":338,"children":339},{},[],{"type":20,"tag":21,"props":341,"children":342},{},[343],{"type":25,"value":344},"大佬们的想法：",{"type":20,"tag":27,"props":346,"children":350},{"alt":347,"src":348,"style":349},"讨论年龄与学习的社交媒体帖子","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F0548402873a966b9ee39b3aa68279daf.png","zoom:25%;",[],{"type":20,"tag":27,"props":352,"children":355},{"alt":353,"src":354,"style":349},"聊天记录：四十岁开始学习 Rust，并鼓励不要给自己加限制","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002Fa3668673b8d7973048ce59f0ef14ef28.png",[],{"type":20,"tag":21,"props":357,"children":358},{},[359],{"type":25,"value":360},"不要限制自己。",{"type":20,"tag":27,"props":362,"children":365},{"alt":363,"src":364,"style":349},"回顾二十多年编程经历和持续学习的帖子","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F15f945a582794e4f1e5bbc92295e4839.png",[],{"type":20,"tag":21,"props":367,"children":368},{},[369],{"type":25,"value":370},"主动出击。你可以分析一下公司的产品，然后主动写邮件给公司提出改进意见：“ 我觉得这样更好 ... ” 可能就会得到一份工作。或者在面试前分析一下，在面试是聊到可以提一嘴。",{"type":20,"tag":21,"props":372,"children":373},{},[374,377],{"type":20,"tag":47,"props":375,"children":376},{},[],{"type":20,"tag":47,"props":378,"children":379},{},[],{"type":20,"tag":21,"props":381,"children":382},{},[383,385,392,394],{"type":25,"value":384},"最后，附上 Joel Spolsky 的",{"type":20,"tag":306,"props":386,"children":389},{"href":387,"rel":388},"http:\u002F\u002Fwww.joelonsoftware.com\u002Farticles\u002FFindingGreatDevelopers.html",[310],[390],{"type":25,"value":391},"博客",{"type":25,"value":393}," ：如何找到优秀的人才。",{"type":20,"tag":306,"props":395,"children":398},{"href":396,"rel":397},"https:\u002F\u002Fwww.ruanyifeng.com\u002Fblog\u002F2008\u002F11\u002Ffinding_great_developers.html",[310],[399],{"type":25,"value":400},"中文翻译版",{"type":20,"tag":21,"props":402,"children":403},{},[404,407],{"type":20,"tag":47,"props":405,"children":406},{},[],{"type":20,"tag":47,"props":408,"children":409},{},[],{"title":7,"searchDepth":411,"depth":411,"links":412},2,[413,414,415],{"id":99,"depth":411,"text":99},{"id":133,"depth":411,"text":133},{"id":214,"depth":411,"text":214},"markdown","content:blog:about-note.md","content","blog\u002Fabout-note.md","blog\u002Fabout-note","md",1793885409024]