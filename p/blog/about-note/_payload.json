[{"data":1,"prerenderedAt":423},["ShallowReactive",2],{"article:blog\u002Fabout-note":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"lang":10,"date":11,"categories":12,"tags":14,"body":16,"_type":417,"_id":418,"_source":419,"_file":420,"_stem":421,"_extension":422},"\u002Fblog\u002Fabout-note","blog",false,"","关于记笔记","学编程该怎样记笔记？Nash 分享从过度整理资料转向以做代学的经历，讨论实践、计算机基础与技术学习中的取舍。","zh-Hans","2022-10-17",[13],"Computer technology",[15],"Chinese & 中文",{"type":17,"children":18,"toc":411},"root",[19,27,34,39,44,54,59,64,69,78,83,88,97,103,108,113,118,123,129,132,137,142,151,156,161,166,175,180,185,194,199,204,213,218,223,228,233,238,243,248,253,258,267,272,292,301,317,322,327,332,338,341,346,352,357,362,367,372,381,402],{"type":20,"tag":21,"props":22,"children":23},"element","p",{},[24],{"type":25,"value":26},"text","当你闭上眼睛，回想自己掌握的知识时，你会发现自己掌握的东西少得可怜：",{"type":20,"tag":28,"props":29,"children":33},"img",{"alt":30,"src":31,"style":32},"用同心圆表示不同范围知识之间的关系","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F36aeabe8e7563462ac2e2d2c70dbec54.png","zoom:50%;",[],{"type":20,"tag":21,"props":35,"children":36},{},[37],{"type":25,"value":38},"我总是怕脑子把学过的东西忘了，相信 “ 好记性不如烂笔头 ” ，把笔记写的很详细（写笔记是相当于要向一个刚入门的小白讲清楚所有知识，也就是做通俗易懂、面面俱到的笔记，以便很多年后我忘掉这些知识以后可以通过笔记快速复习回忆），结果深陷记笔记泥潭进度严重滞后。",{"type":20,"tag":21,"props":40,"children":41},{},[42],{"type":25,"value":43},"其实脑子根本没有那么容易忘记，因为每天都和那些东西打交道。",{"type":20,"tag":21,"props":45,"children":46},{},[47,51],{"type":20,"tag":48,"props":49,"children":50},"br",{},[],{"type":20,"tag":48,"props":52,"children":53},{},[],{"type":20,"tag":21,"props":55,"children":56},{},[57],{"type":25,"value":58},"现在想学编程，完全可以从网上获取成为一个合格计算机工程师所需的全部资料。",{"type":20,"tag":21,"props":60,"children":61},{},[62],{"type":25,"value":63},"然而面对 “ 堆积如山 ” 的资料，我意识到想把这么多资料整理到自己的 markdown 笔记里、总结完是不可能的，能认真看完就不错了。",{"type":20,"tag":21,"props":65,"children":66},{},[67],{"type":25,"value":68},"只能把它们归类，然后按原有的形态存着。",{"type":20,"tag":21,"props":70,"children":71},{},[72,75],{"type":20,"tag":48,"props":73,"children":74},{},[],{"type":20,"tag":48,"props":76,"children":77},{},[],{"type":20,"tag":21,"props":79,"children":80},{},[81],{"type":25,"value":82},"以做代学，实战上手边做边学（直接开始研究 \u002F 做中等难度的东西，再降维打击简单的内容，最后打牢基础攻关难的）；不必整合各种学习资料、做详细笔记，看视频和看书脑子理解了，看懂就行。笔记只记录精华思想、感悟即可。学完后有时间再快速归档整理一下笔记，顺便反思研究。",{"type":20,"tag":21,"props":84,"children":85},{},[86],{"type":25,"value":87},"以快速突进掌握实践技术为主，笔记后续跟进迅速完善覆盖。如果是从基础开始学一点做一点笔记、笔记做的特别详细，虽然笔记做的很好，但是可能会严重拖慢进度。",{"type":20,"tag":21,"props":89,"children":90},{},[91,94],{"type":20,"tag":48,"props":92,"children":93},{},[],{"type":20,"tag":48,"props":95,"children":96},{},[],{"type":20,"tag":98,"props":99,"children":101},"h2",{"id":100},"不要什么都记",[102],{"type":25,"value":100},{"type":20,"tag":21,"props":104,"children":105},{},[106],{"type":25,"value":107},"不要做基础文档笔记：直接复制现有文档就行了。",{"type":20,"tag":21,"props":109,"children":110},{},[111],{"type":25,"value":112},"基础知识网上都有，不用记，看已有的文档书籍即可，由 PDF 文件、复制下来的 markdown 文件、HTML 文件 组成。",{"type":20,"tag":21,"props":114,"children":115},{},[116],{"type":25,"value":117},"在学习过基础之后，记录一下 遇到的问题、解决方法、思路、总结 这些中高级笔记。",{"type":20,"tag":21,"props":119,"children":120},{},[121],{"type":25,"value":122},"技术永远在更新，你的精力有限，不可能把所有东西都做一遍笔记，然后一直维护这些笔记确保它们不过时。",{"type":20,"tag":28,"props":124,"children":128},{"alt":125,"src":126,"style":127},"从基础知识、总结到个人知识笔记的分层示意图","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F2048dc5f6e3172152d62a7e63530e2a5.png","zoom:30%;",[],{"type":20,"tag":48,"props":130,"children":131},{},[],{"type":20,"tag":98,"props":133,"children":135},{"id":134},"研究计算机基础",[136],{"type":25,"value":134},{"type":20,"tag":21,"props":138,"children":139},{},[140],{"type":25,"value":141},"学的基础知识底层知识越多越牢，先补一些计算机基础，学新知识也越快。",{"type":20,"tag":21,"props":143,"children":144},{},[145,148],{"type":20,"tag":48,"props":146,"children":147},{},[],{"type":20,"tag":48,"props":149,"children":150},{},[],{"type":20,"tag":21,"props":152,"children":153},{},[154],{"type":25,"value":155},"计算机知识体系像一棵树🌲，越底层的东西越难。",{"type":20,"tag":21,"props":157,"children":158},{},[159],{"type":25,"value":160},"你从树叶开始入门，如果你只会一根树枝的知识，那你只能轻松精通这一根树枝上所有树叶的知识。",{"type":20,"tag":21,"props":162,"children":163},{},[164],{"type":25,"value":165},"（树干 = 底层知识：计算机基础；树枝 = 中层知识：框架原理；树叶 = 简单的应用层知识：框架使用）",{"type":20,"tag":21,"props":167,"children":168},{},[169,172],{"type":20,"tag":48,"props":170,"children":171},{},[],{"type":20,"tag":48,"props":173,"children":174},{},[],{"type":20,"tag":21,"props":176,"children":177},{},[178],{"type":25,"value":179},"如果你学习了 2 种树枝的知识你就可以快速掌握这 2 个树枝上新长出来的树叶知识，但是要学习其他树枝那就得多花点精力学习了。",{"type":20,"tag":21,"props":181,"children":182},{},[183],{"type":25,"value":184},"如果你花时间研究明白了树干的知识，那对你来说，学习树枝和树叶就简单了，你可以快速学习几乎任何一个方向，比如前端、后端等等，因为你已经有树干了。",{"type":20,"tag":21,"props":186,"children":187},{},[188,191],{"type":20,"tag":48,"props":189,"children":190},{},[],{"type":20,"tag":48,"props":192,"children":193},{},[],{"type":20,"tag":21,"props":195,"children":196},{},[197],{"type":25,"value":198},"总之，你要成为高级工程师的树干就那么粗，早晚都得学，而且如果掌握了树干，上面长出新树叶就能快速学习了。",{"type":20,"tag":21,"props":200,"children":201},{},[202],{"type":25,"value":203},"另一种极端情况：如果只会树叶，不会树枝，就只能拼命跟随树叶，长出来多少树叶，就要学多少树叶。",{"type":20,"tag":21,"props":205,"children":206},{},[207,210],{"type":20,"tag":48,"props":208,"children":209},{},[],{"type":20,"tag":48,"props":211,"children":212},{},[],{"type":20,"tag":98,"props":214,"children":216},{"id":215},"技术发展与职业规划",[217],{"type":25,"value":215},{"type":20,"tag":21,"props":219,"children":220},{},[221],{"type":25,"value":222},"技术的发展是很快，新技术层出不穷，迭代非常快。",{"type":20,"tag":21,"props":224,"children":225},{},[226],{"type":25,"value":227},"阮一峰老师的博客里提出过这个问题。",{"type":20,"tag":21,"props":229,"children":230},{},[231],{"type":25,"value":232},"大致意思是说：",{"type":20,"tag":21,"props":234,"children":235},{},[236],{"type":25,"value":237},"学习技术的可能过不了 7、8 年就淘汰了。就像在 2007 年刚学习了诺基亚的塞班系统开发，苹果 、安卓又开始偷偷萌芽了。",{"type":20,"tag":21,"props":239,"children":240},{},[241],{"type":25,"value":242},"2020 年的时候在武汉大学校园里见过一次无人车，“ 别人家的学校🥹 ” ，当时有很多同学拍照，感觉这黑科技太酷了。但是无人车差不多也只是在 2016、2017 年左右开始火的。",{"type":20,"tag":21,"props":244,"children":245},{},[246],{"type":25,"value":247},"刚毕业时学的技术栈不太可能用到退休（50 年），只能在毕业后的 5 ~ 15 年用上，之后就得靠底层的树干技术学习新树叶了。",{"type":20,"tag":21,"props":249,"children":250},{},[251],{"type":25,"value":252},"（50 年，22 岁到 75 岁左右，这里有为什么 75 岁退休：医疗条件好 > 不愿意生孩子 > 人口老龄化 > 财政税收不能负担退休金 > 延迟退休，所以为什么医疗条件这么好 > 因为科技在爆炸式发展，00 后的人活 120 岁左右）",{"type":20,"tag":21,"props":254,"children":255},{},[256],{"type":25,"value":257},"当一种技术被取代时，相关的工作岗位也就消失了。这种事情在技术行业特别多，因为技术的升级换代太快了。",{"type":20,"tag":21,"props":259,"children":260},{},[261,264],{"type":20,"tag":48,"props":262,"children":263},{},[],{"type":20,"tag":48,"props":265,"children":266},{},[],{"type":20,"tag":21,"props":268,"children":269},{},[270],{"type":25,"value":271},"怎么应对技术太快：",{"type":20,"tag":273,"props":274,"children":275},"ol",{},[276,282,287],{"type":20,"tag":277,"props":278,"children":279},"li",{},[280],{"type":25,"value":281},"退出技术行业，转行",{"type":20,"tag":277,"props":283,"children":284},{},[285],{"type":25,"value":286},"转管理，或者创业开公司",{"type":20,"tag":277,"props":288,"children":289},{},[290],{"type":25,"value":291},"拼命学习，靠基础好、深入底层，学习速度会比年轻人快",{"type":20,"tag":21,"props":293,"children":294},{},[295,298],{"type":20,"tag":48,"props":296,"children":297},{},[],{"type":20,"tag":48,"props":299,"children":300},{},[],{"type":20,"tag":21,"props":302,"children":303},{},[304,306,315],{"type":25,"value":305},"在现在，从",{"type":20,"tag":307,"props":308,"children":312},"a",{"href":309,"rel":310},"https:\u002F\u002Fwww.ruanyifeng.com\u002Fsurvivor\u002Fcollapse\u002Funiversity.html",[311],"nofollow",[313],{"type":25,"value":314},"网上",{"type":25,"value":316},"几乎可以获取所有学习资料。",{"type":20,"tag":21,"props":318,"children":319},{},[320],{"type":25,"value":321},"我很讨厌上课，在上课时我很难学到真正有用的知识，也可能是学校教的内容太传统 😴。于是乎，我上课前都会偷偷卸载教室电脑的投屏授课软件，然后学习我想学的东西，这种感觉很好，感觉时间没有浪费。这样我就能利用上课时间去学习需要的东西。",{"type":20,"tag":21,"props":323,"children":324},{},[325],{"type":25,"value":326},"我不依赖上课，只从图书馆借书或者从网上收集资料（电子书、别人的技术文章、网课）。网课的效率非常高，我可以把视频调到 1.5 倍速，或者跳过我已经知道的地方，直接快进到我想听的地方。当然不是所有人都适合我这种方法，只是我自己喜欢这样学罢了。",{"type":20,"tag":21,"props":328,"children":329},{},[330],{"type":25,"value":331},"每个人都有适合自己的学习方法。",{"type":20,"tag":28,"props":333,"children":337},{"alt":334,"src":335,"style":336},"包含曲线、饼图和知识结构的笔记页面","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002Ff568df9647bb1aa1a5d034aeeb836306.png","zoom:150%;",[],{"type":20,"tag":48,"props":339,"children":340},{},[],{"type":20,"tag":21,"props":342,"children":343},{},[344],{"type":25,"value":345},"大佬们的想法：",{"type":20,"tag":28,"props":347,"children":351},{"alt":348,"src":349,"style":350},"讨论年龄与学习的社交媒体帖子","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F0548402873a966b9ee39b3aa68279daf.png","zoom:25%;",[],{"type":20,"tag":28,"props":353,"children":356},{"alt":354,"src":355,"style":350},"聊天记录：四十岁开始学习 Rust，并鼓励不要给自己加限制","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002Fa3668673b8d7973048ce59f0ef14ef28.png",[],{"type":20,"tag":21,"props":358,"children":359},{},[360],{"type":25,"value":361},"不要限制自己。",{"type":20,"tag":28,"props":363,"children":366},{"alt":364,"src":365,"style":350},"回顾二十多年编程经历和持续学习的帖子","https:\u002F\u002Fpub-61f1a97788f1425894bfc0ead4718906.r2.dev\u002Fimages\u002Fposts\u002F2022\u002F12\u002F13\u002F15f945a582794e4f1e5bbc92295e4839.png",[],{"type":20,"tag":21,"props":368,"children":369},{},[370],{"type":25,"value":371},"主动出击。你可以分析一下公司的产品，然后主动写邮件给公司提出改进意见：“ 我觉得这样更好 ... ” 可能就会得到一份工作。或者在面试前分析一下，在面试是聊到可以提一嘴。",{"type":20,"tag":21,"props":373,"children":374},{},[375,378],{"type":20,"tag":48,"props":376,"children":377},{},[],{"type":20,"tag":48,"props":379,"children":380},{},[],{"type":20,"tag":21,"props":382,"children":383},{},[384,386,393,395],{"type":25,"value":385},"最后，附上 Joel Spolsky 的",{"type":20,"tag":307,"props":387,"children":390},{"href":388,"rel":389},"http:\u002F\u002Fwww.joelonsoftware.com\u002Farticles\u002FFindingGreatDevelopers.html",[311],[391],{"type":25,"value":392},"博客",{"type":25,"value":394}," ：如何找到优秀的人才。",{"type":20,"tag":307,"props":396,"children":399},{"href":397,"rel":398},"https:\u002F\u002Fwww.ruanyifeng.com\u002Fblog\u002F2008\u002F11\u002Ffinding_great_developers.html",[311],[400],{"type":25,"value":401},"中文翻译版",{"type":20,"tag":21,"props":403,"children":404},{},[405,408],{"type":20,"tag":48,"props":406,"children":407},{},[],{"type":20,"tag":48,"props":409,"children":410},{},[],{"title":7,"searchDepth":412,"depth":412,"links":413},2,[414,415,416],{"id":100,"depth":412,"text":100},{"id":134,"depth":412,"text":134},{"id":215,"depth":412,"text":215},"markdown","content:blog:about-note.md","content","blog\u002Fabout-note.md","blog\u002Fabout-note","md",1794571148029]