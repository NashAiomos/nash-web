{
  "name": "nuxt-app",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "stylelint:fix": "npx stylelint **/*.{css,scss,vue,less,html} --fix",
    "test:comments": "node workers/comments/test/integration.mjs",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@iconify-json/icon-park-outline": "^1.1.12",
    "@iconify-json/simple-icons": "^1.1.79",
    "@parcel/watcher": "^2.5.1",
    "@unocss/reset": "66.12.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@nuxt/content": "^2.9.0",
    "@nuxtjs/stylelint-module": "^5.1.0",
    "@types/node": "^20.9.3",
    "@typescript-eslint/parser": "^8.0.0",
    "@unocss/nuxt": "66.12.0",
    "@vueuse/core": "^10.6.1",
    "@vueuse/nuxt": "^10.6.1",
    "eslint": "^8.39.0",
    "eslint-plugin-vue": "^9.32.0",
    "lint-staged": "^15.1.0",
    "nuxt": "^3.15.4",
    "postcss-html": "^1.8.0",
    "sass": "^1.69.5",
    "sharp": "0.35.5",
    "simple-git-hooks": "^2.9.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-vue": "1.5.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "typescript": "^5.0.0",
    "unocss": "66.12.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{css,scss,less,html}": [
      "stylelint --fix"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "simple-git-hooks"
    ],
    "overrides": {
      "stylelint-config-recommended-vue@1.5.0>stylelint-config-html": "1.1.0",
      "stylelint-config-recommended-vue@1.5.0>stylelint-config-recommended": "13.0.0"
    }
  }
}
